{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GroupVocabulary",
  "description": "A named list of group ids with their labels. Labels live here and only\nhere — they used to be written on each year's tree while descriptions\ncame from the taxonomy, and the two drifted the first time a category\nwas renamed.",
  "$defs": {
    "Group": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "label",
        "description"
      ],
      "title": "Group",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/Group"
      },
      "minItems": 1,
      "title": "Groups",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "groups"
  ],
  "type": "object"
}
